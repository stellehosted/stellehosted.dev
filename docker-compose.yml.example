services:
  stellehosted.dev:
    container_name: "stellehosted.dev"
    build:
      context: .
      dockerfile: server/Dockerfile

    environment:
      NAVIDROME_URL: http://navidrome:4533
      NAVIDROME_USER: 
      NAVIDROME_PASSWORD: 
      NAVIDROME_USERNAME_FILTER: 

      # Serve test now-playing data (see server/mock.js)
      # paused, warm, dark, light, long, short, nocover, nothing
      NOWPLAYING_MOCK: ""

    volumes:
      - ./content:/app/content:ro
      - ./content/manifests:/app/content/manifests

    networks:
      - stellehosted.dev

    ports:
      - 1030:8080
      
    restart: unless-stopped

networks:
  stellehosted.dev:
    external: true
